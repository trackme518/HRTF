<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.trackmeifyoucan</groupId>
  <artifactId>HRTF</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>HRTF</name>
  <description>Binaural 3D audio (HRTF convolution) library for Processing, integrating with the Sound library. Author: Vojtech Leischner, 2026, trackmeifyoucan.com</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
    <processing.home>C:/Users/leischner/Documents/processing-4.3.4</processing.home>
    <sketchbook.home>C:/Users/leischner/Documents/Processing</sketchbook.home>
  </properties>

  <dependencies>
    <!-- compile/link-time only, never packaged -->
    <dependency>
      <groupId>org.processing</groupId>
      <artifactId>core</artifactId>
      <version>4.3.4</version>
      <scope>system</scope>
      <systemPath>${processing.home}/core/library/core.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>processing</groupId>
      <artifactId>sound</artifactId>
      <version>2.4.0</version>
      <scope>system</scope>
      <systemPath>${sketchbook.home}/libraries/sound/library/sound.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>com.jsyn</groupId>
      <artifactId>jsyn</artifactId>
      <version>17.1.0</version>
      <scope>system</scope>
      <systemPath>${sketchbook.home}/libraries/sound/library/jsyn-17.1.0.jar</systemPath>
    </dependency>

    <!-- runtime dependencies, shaded and relocated into the library jar -->
    <dependency>
      <groupId>io.jhdf</groupId>
      <artifactId>jhdf</artifactId>
      <version>0.10.0</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>2.0.17</version>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-lang3</artifactId>
      <version>3.18.0</version>
    </dependency>
    <dependency>
      <groupId>com.ning</groupId>
      <artifactId>compress-lzf</artifactId>
      <version>1.1.2</version>
    </dependency>
    <dependency>
      <groupId>org.lz4</groupId>
      <artifactId>lz4-java</artifactId>
      <version>1.8.0</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>HRTF</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <artifactSet>
                <includes>
                  <include>io.jhdf:jhdf</include>
                  <include>org.slf4j:slf4j-api</include>
                  <include>org.apache.commons:commons-lang3</include>
                  <include>com.ning:compress-lzf</include>
                  <include>org.lz4:lz4-java</include>
                </includes>
              </artifactSet>
              <relocations>
                <relocation>
                  <pattern>io.jhdf</pattern>
                  <shadedPattern>com.trackmeifyoucan.hrtf.deps.io.jhdf</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>org.slf4j</pattern>
                  <shadedPattern>com.trackmeifyoucan.hrtf.deps.org.slf4j</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>org.apache.commons.lang3</pattern>
                  <shadedPattern>com.trackmeifyoucan.hrtf.deps.org.apache.commons.lang3</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>com.ning.compress</pattern>
                  <shadedPattern>com.trackmeifyoucan.hrtf.deps.com.ning.compress</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>net.jpountz</pattern>
                  <shadedPattern>com.trackmeifyoucan.hrtf.deps.net.jpountz</shadedPattern>
                </relocation>
              </relocations>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
